STAGE=dev
API_KEY=mock-api-key-12345
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Local AWS credentials to authenticate Bedrock calls in dev (not used in
# deployed Lambda, which relies on its IAM role). Use ONE of the options below:
#   Option A: AWS_PROFILE=<sso-profile-name> (run `aws sso login` first)
#   Option B: AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY from an IAM user
# Setting both at once is ambiguous and AWS_PROFILE wins.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
